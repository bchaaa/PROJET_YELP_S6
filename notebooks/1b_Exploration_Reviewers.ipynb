   "source": [
    "# Phase 1b : Analyse des Utilisateurs (Reviewers)\n",
    "Objectif : Determiner si les utilisateurs experts (Elite) sont plus severes dans leur notation."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "import os\n",
    "import sys\n",
    "from scipy.stats import ttest_ind\n",
    "sys.path.append(os.path.abspath('..'))\n",
    "from src.data_loader import load_yelp_sample\n",
    "sns.set_theme()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Chargement des donnees Utilisateurs\n",
    "df_user = load_yelp_sample('../data/raw/user.json', n_rows=50000)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Creation d'une colonne binaire pour identifier les membres Elite\n",
    "df_user['is_elite'] = df_user['elite'].apply(lambda x: 1 if x != '' and x != 'None' else 0)\n",
    "\n",
    "# Separation des notes moyennes des deux groupes\n",
    "elite = df_user[df_user['is_elite'] == 1]['average_stars']\n",
    "norm = df_user[df_user['is_elite'] == 0]['average_stars']\n",
    "\n",
    "print(f'Note moyenne Elite : {elite.mean():.2f}')\n",
    "print(f'Note moyenne Standard : {norm.mean():.2f}')\n",
    "\n",
    "# Affichage de la densite de probabilite (kde)\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.kdeplot(elite, label='Membres Elite', fill=True)\n",
    "sns.kdeplot(norm, label='Utilisateurs Standards', fill=True)\n",
    "plt.title('Distribution des notes moyennes par type d\\'utilisateur')\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  }
 ],
