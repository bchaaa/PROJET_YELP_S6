   "source": [
    "# Phase 1a : Analyse des Commerces (Business)\n",
    "Objectif : Verifier si les etablissements les plus frequentes ont de meilleures notes que les autres."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "import os\n",
    "import sys\n",
    "from scipy.stats import mannwhitneyu\n",
    "sys.path.append(os.path.abspath('..'))\n",
    "from src.data_loader import load_yelp_sample\n",
    "# Configuration du style des graphiques\n",
    "sns.set_theme()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Chargement des donnees Business (50 000 lignes)\n",
    "df_biz = load_yelp_sample('../data/raw/business.json', n_rows=50000)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# On separe les commerces en deux groupes : les tres populaires (top 10%) et les autres\n",
    "threshold = df_biz['review_count'].quantile(0.9)\n",
    "pop = df_biz[df_biz['review_count'] > threshold]['stars']\n",
    "other = df_biz[df_biz['review_count'] <= threshold]['stars']\n",
    "\n",
    "# Test statistique de Mann-Whitney U pour comparer les distributions\n",
    "stat, p = mannwhitneyu(pop, other)\n",
    "print(f'P-value du test : {p:.2e}')\n",
    "\n",
    "# Visualisation sous forme de boites a moustaches\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.boxplot(data=[pop, other], palette='Set2').set_xticklabels(['Populaires', 'Standards'])\n",
    "plt.title('Comparaison des notes : Populaires vs Standards')\n",
    "plt.show()"
   ]
  }
 ],
