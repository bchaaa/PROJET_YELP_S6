   "source": [
    "# Phase 1c : Analyse Textuelle\n",
    "Objectif : Identifier les mots les plus frequents dans les mauvais avis (1 etoile)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "import os\n",
    "import sys\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer\n",
    "sys.path.append(os.path.abspath('..'))\n",
    "from src.data_loader import load_yelp_sample"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# On charge un echantillon d'avis\n",
    "df = load_yelp_sample('../data/raw/review.json', n_rows=20000)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extraction des avis negatifs (1 etoile)\n",
    "neg_txt = df[df['stars'] == 1]['text'].head(1000)\n",
    "\n",
    "# Utilisation de TF-IDF pour trouver les mots significatifs (hors mots de liaison)\n",
    "vec = TfidfVectorizer(stop_words='english', max_features=20)\n",
    "vec.fit(neg_txt)\n",
    "\n",
    "print('Liste des 20 mots les plus caracteristiques des avis negatifs :')\n",
    "print(list(vec.vocabulary_.keys()))"
   ]
  }
 ],
