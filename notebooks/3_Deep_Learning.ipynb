   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Phase 3 : Deep Learning - Comparaison d'architectures\n",
    "On teste trois reseaux de neurones differents. Les performances sont presentees dans des tableaux Pandas."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import pickle\n",
    "import os\n",
    "import sys\n",
    "from sklearn.neural_network import MLPClassifier\n",
    "from sklearn.metrics import classification_report\n",
    "sys.path.append(os.path.abspath('..'))\n",
    "from src.data_loader import load_yelp_sample\n",
    "\n",
    "vec = pickle.load(open('../models/vectorizer.pkl', 'rb'))\n",
    "df = load_yelp_sample('../data/raw/review.json', n_rows=50000)\n",
    "df['label'] = (df['stars'] <= 2).astype(int)\n",
    "X = vec.transform(df['text'])\n",
    "y = df['label']"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Architecture 1 : Standard (64, 32)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "mlp1 = MLPClassifier(hidden_layer_sizes=(64, 32), early_stopping=True, random_state=42)\n",
    "mlp1.fit(X, y)\n",
    "report_m1 = classification_report(y, mlp1.predict(X), output_dict=True)\n",
    "display(pd.DataFrame(report_m1).transpose().round(2))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Architecture 2 : Profonde (128, 64, 32)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "mlp2 = MLPClassifier(hidden_layer_sizes=(128, 64, 32), early_stopping=True, random_state=42)\n",
    "mlp2.fit(X, y)\n",
    "report_m2 = classification_report(y, mlp2.predict(X), output_dict=True)\n",
    "display(pd.DataFrame(report_m2).transpose().round(2))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Architecture 3 : Large (256)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "mlp3 = MLPClassifier(hidden_layer_sizes=(256,), early_stopping=True, random_state=42)\n",
    "mlp3.fit(X, y)\n",
    "report_m3 = classification_report(y, mlp3.predict(X), output_dict=True)\n",
    "display(pd.DataFrame(report_m3).transpose().round(2))\n",
    "pickle.dump(mlp1, open('../models/deep_model.pkl', 'wb'))"
   ]
  }
 ],
